upstream core {
    server ${UPSTREAM_SERVER}:8000;
}

upstream frontend {
    server node:3000;
}

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    location /elb/healthcheck {
        access_log off;
        return 200;
        add_header Content-Type text/plain;
    }

    location /assets/ {
        alias /var/www/static/;
    }

    location /dev_assets/ {
        alias /app/core/static/;
    }

    location /media/ {
        alias /app/core/media/;
    }

    # Blocks any hidden/dotfile path (.env, .env.local, .git/*, .htaccess, etc.) —
    # defense-in-depth even though none of these are routable to a Django view anyway.
    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://core;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-CSRFToken $http_x_csrftoken;
        proxy_set_header Referer $http_referer;
        proxy_set_header Cookie $http_cookie;
    }
}

# Fronts the Next.js app the same way the block above fronts Django — same
# dotfile protection, no longer relying on the node container's own port
# being reachable directly from outside.
server {
    listen 3000;
    server_name ${SERVER_NAME};

    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }
}